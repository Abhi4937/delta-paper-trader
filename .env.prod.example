# Copy to ".env" in the repo root for docker-compose.prod.yml. NEVER commit the real .env.
# These feed compose interpolation (DB, domain, and the PUBLIC Supabase values baked into
# the frontend build).

# Your domain (DNS A-record must point at this VM). Caddy gets HTTPS for it automatically.
DOMAIN=paper-trader-abhi.duckdns.org

# Database
POSTGRES_USER=paper
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=paper_trader

# Supabase (PUBLIC — safe in the browser; baked into the frontend at build time)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx_or_anon_eyJ...
