# Copy to .env and fill in. NEVER commit .env.
# --- Delta Exchange India (READ-ONLY key only; no orders are ever placed) ---
DELTA_API_BASE=https://api.india.delta.exchange
DELTA_WS_BASE=wss://socket.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# Margin estimator (web-session token; estimate_margin does NOT accept API keys).
# Copy the "authorization: Bearer <token>" value from the estimate_margin request
# headers (paste only the token, without "Bearer "). Expires — refresh as needed.
DELTA_WEB_BASE=https://cdn.india.deltaex.org
DELTA_WEB_JWT=

# --- Database (Postgres + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://paper:paper@localhost:5432/paper_trader

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Supabase = identity only) ---
# From Supabase project settings → API. SUPABASE_JWT_SECRET verifies access tokens.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
# Per-user secret vault master key. Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_VAULT_KEY=
# First admin + first allowlisted email (seeded on startup).
ADMIN_EMAIL=

# --- App ---
APP_ENV=dev
# CORS: comma-separated allowed origins. In PRODUCTION set this to your real domain
# (e.g. https://app.example.com) — never "*".
CORS_ORIGINS=http://localhost:3000
# Local-only auth bypass (no token → stub user). MUST stay false/absent in production;
# only works when APP_ENV=dev too. Set true for local dev without logging in.
ALLOW_DEV_NO_AUTH=false
# Per-IP API rate limit (requests/min). Leave enabled in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=1200
VIRTUAL_START_BALANCE_INR=500000
