# Copy to .env and fill in. NEVER commit .env.
# --- Delta Exchange India (READ-ONLY key only; no orders are ever placed) ---
DELTA_API_BASE=https://api.india.delta.exchange
DELTA_WS_BASE=wss://socket.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# Margin estimator (web-session token; estimate_margin does NOT accept API keys).
# Copy the "authorization: Bearer <token>" value from the estimate_margin request
# headers (paste only the token, without "Bearer "). Expires — refresh as needed.
DELTA_WEB_BASE=https://cdn.india.deltaex.org
DELTA_WEB_JWT=

# --- Database (Postgres + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://paper:paper@localhost:5432/paper_trader

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000
VIRTUAL_START_BALANCE_INR=500000
