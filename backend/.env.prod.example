# Copy to backend/.env.prod (NEVER commit). Backend secrets for production.
# NOTE: DATABASE_URL, APP_ENV, ALLOW_DEV_NO_AUTH and CORS_ORIGINS are injected by
# docker-compose.prod.yml — do NOT set them here.

# --- Delta Exchange India (READ-ONLY market-data key; no orders are ever placed) ---
DELTA_API_BASE=https://api.india.delta.exchange
DELTA_WS_BASE=wss://socket.india.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=
# Optional global web-session token for exact margin (per-user vault tokens also work).
DELTA_WEB_BASE=https://cdn.india.deltaex.org
DELTA_WEB_JWT=

# --- Auth (Supabase = identity only) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_AUD=authenticated
# Per-user secret vault master key (urlsafe base64, 32 bytes). Generate:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_VAULT_KEY=
# First admin + first allowlisted email (seeded on startup).
ADMIN_EMAIL=you@example.com

# --- Rate limit ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=1200
